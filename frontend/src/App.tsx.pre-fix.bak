type CostSheetLine = {
  id?: number
  tempId?: string // 
  isDeleted?: boolean
  sectionCode: string
  categoryCode: string
  categoryName: string
  itemName: string
  description: string
  articleNumber: string
  supplier: string
  quantity: number
  quantityUnit: string
  unitPrice: number
  priceUnit: string
  calculatedAmount: number
  notes: string
  displayOrder: number
}
type GridEditLine = CostSheetLine & {
  costSheetId?: number; // 影子外鍵：用於 Dapper 批量寫入
  isBlank?: boolean;    // 影子標記：用於前端垃圾過濾
};
type CostSheetHeader = {
  id?: number
  originalCostSheetId?: number
  createdBy?: string
  modifiedBy?: string
  vendor: string
  vendorName?: string
  buyer: string
  buyerName?: string
  season: string
  seasonYear: string
  stage: string
  pdStyle: string
  style: string
  revisionNumber: number
  recordStatus: string
  currency: string
  royaltyRate: number
  notes: string
  createdDate?: string
  modifiedDate?: string
  materialSubtotal?: number
  accessoriesSubtotal?: number
  quotaSubtotal?: number
  cmOverheadSubtotal?: number
  fobPrice?: number
  royaltyAmount?: number
  finalPriceIncludingRoyalty?: number
  lines: CostSheetLine[]
}

type CostSheetSearchResult = {
  id: number
  pdStyle: string
  style: string
  vendor: string
  season: string
  revisionNumber: number
  stage: string
  recordStatus: string
  modifiedDate: string
}

type MasterOption = {
  code: string
  name: string
}

type CostCategoryOption = {
  id: number
  sectionCode: string
  code: string
  name: string
  isActive: boolean
}

type CostStageOption = {
  id: number
  name: string
  isActive: boolean
}
